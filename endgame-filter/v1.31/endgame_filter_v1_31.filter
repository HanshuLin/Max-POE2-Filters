# POE2 0.5 ENDGAME VALUE FILTER V1.31
# Generated: 2026-08-06
# Economy snapshot: 2026-08-03 18:00:00 Asia/Shanghai
# Conversion snapshot: 1C=213E, 1D=970E
# Value bands: Green >=1C, Blue >=1D, Purple >=3D, Red >=100D
# Unique equipment: NeverSink 0.10.3 proxy; <=T3 hidden, T2 blue, T1 purple; Vaal uniques override to red; unknown uniques use P0.

#===================================================================================================
# 01. Quest and instance-local items — absolute priority
#===================================================================================================
Show
    AlwaysShow True
    SetFontSize 32
    SetTextColor 188 96 37 255
    SetBorderColor 188 96 37 255
    SetBackgroundColor 0 0 0 220
    MinimapIcon 2 Brown Star
    DisableDropSound

Show
    Class == "Quest Items" "Instance Local Items"
    SetFontSize 32
    SetTextColor 188 96 37 255
    SetBorderColor 188 96 37 255
    SetBackgroundColor 0 0 0 220
    MinimapIcon 2 Brown Star
    DisableDropSound

#===================================================================================================
# 02. Gold — inherited compact rule, no border/icon/beam/sound
#===================================================================================================
Show
    BaseType == "Gold"
    SetFontSize 24
    SetBorderColor 0 0 0 0
    DisableDropSound

