# ============================================================================
# 00｜任务与无法恢复物品
# ============================================================================

# G2｜任务物品与区域内物品｜安全保护，避免任务流程物品被隐藏。
Show
    Class == "Instance Local Items" "Quest Items"
    SetTextColor 88 211 79 255
    SetBackgroundColor 0 0 0 220
    SetBorderColor 220 220 220 255
    SetFontSize 32
    DisableDropSound

# W1｜客户端标记为始终显示的物品｜服从客户端不可恢复物品标记。
Show
    AlwaysShow True
    SetTextColor 255 255 255 255
    SetBackgroundColor 0 0 0 220
    SetBorderColor 0 0 0 0
    SetFontSize 32
    DisableDropSound

# ============================================================================
# 01｜装备｜传奇特例
# ============================================================================

# P4｜双重腐化传奇装备｜传奇装备使用 Star，特殊状态升级为紫色。
Show
    TwiceCorrupted True
    Rarity Unique
    Class == "Amulets" "Belts" "Body Armours" "Boots" "Bows" "Bucklers" "Charms" "Crossbows" "Foci" "Gloves" "Helmets" "Life Flasks" "Mana Flasks" "One Hand Maces" "Quarterstaves" "Quivers" "Rings" "Sceptres" "Shields" "Spears" "Staves" "Talismans" "Two Hand Maces" "Wands"
